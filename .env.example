# Copy to .env (gitignored) and fill in. Nothing here is required for the offline demo:
# with none of these set, the desk runs fully on Fakes + the in-memory store.
# In production, inject secrets per-container (SOPS+age / 1Password CLI) and keep ingest creds,
# sell creds, and money creds separate.

# --- local infra (docker-compose) ---
# These power the optional docker-compose stack (Postgres/pgvector, Redis, MinIO). Persisting the
# app to Postgres is on the roadmap — the default Store is in-memory, so DATABASE_URL is not yet
# read by the runtime. Use throwaway values locally; replace every CHANGE_ME anywhere shared.
DATABASE_URL=postgres://flip:CHANGE_ME@localhost:5432/flipdesk
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=flip
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=flip-desk

# --- runtime seam selection (@flip-desk/runtime) ---
# With none of the below set, the desk runs fully offline on Fakes + the in-memory store (demo mode).
# ANTHROPIC_API_KEY present -> FakeLlm swaps to the live AnthropicLlm (/v1/messages).
# FLIP_LIVE_HTTP=1          -> FakeTransport swaps to FetchTransport (real network).
FLIP_LIVE_HTTP=

# --- LLM (Anthropic API) — powers identify (extraction) and the weekly analyst memo ---
ANTHROPIC_API_KEY=

# --- comps / catalogs (T0) — enable per vertical ---
PRICECHARTING_API_KEY=
KEEPA_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- budgets / policy ---
LLM_USD_DAY_CAP=40
PURCHASE_USD_DAY_CAP=200
